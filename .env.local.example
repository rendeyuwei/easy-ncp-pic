# EasyPic local development configuration.
# Copy this file to .env.local and replace the example secrets.

EASYPIC_DB=.data/easypic.sqlite
EASYPIC_SESSION_SECRET=replace-with-a-long-random-local-secret
EASYPIC_ADMIN_USERNAME=admin
EASYPIC_ADMIN_PASSWORD=replace-with-a-local-admin-password
EASYPIC_COOKIE_SECURE=false
# Optional deployment-only setting when EasyPic is hosted below a URL prefix.
# EASYPIC_COOKIE_PATH=/easypic/
